    {
      "type": "mcq_single",
      "prompt": "Как правильно перевести: «Если бы ты мог, ты бы помог»?",
      "choices": [
        {
          "id": "a",
          "text": "Si puedes, ayudarías."
        },
        {
          "id": "b",
          "text": "Si podrías, ayudarías."
        },
        {
          "id": "c",
          "text": "Si pudieras, ayudarías."
        },
        {
          "id": "d",
          "text": "Si pudieras, ayudarás."
        }
      ],
      "correct_answer": "c",
      "explanation": "Во втором условном предложении после si используется imperfecto de subjuntivo «pudieras», а результат ставится в condicional «ayudarías».",
      "theory_block_id": "b6_theory_typical_ru_mistakes",
