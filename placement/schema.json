{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone Linglow placement item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "skill_id",
    "family_id",
    "level",
    "difficulty",
    "context",
    "instruction",
    "prompt",
    "choices",
    "correct_answer",
    "explanation",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "correct_answer": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "context": {
      "type": "string"
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "difficulty": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    },
    "choices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
