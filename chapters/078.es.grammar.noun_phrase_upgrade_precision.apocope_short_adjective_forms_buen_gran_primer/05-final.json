    {
      "id": "b2_theory_bueno_buen_position_and_agreement",
      "type": "theory",
      "title": "bueno -> buen: позиция и согласование",
      "theory": {
        "concept_id": "bueno_buen_position_and_agreement",
        "content_md": "## bueno -> buen: позиция и согласование\n\n\nПеред существительным мужского рода ед. числа: buen; в остальных позициях и формах: bueno/buena/buenos/buenas.\n\nbuen используется как определение перед masculino singular: buen amigo.\n\nПолная форма bueno часто стоит после существительного: un amigo bueno.\n\nС женским родом апокопы нет: buena película.",
        "key_points": [],
        "common_mistakes": [
          {
            "wrong": "un bueno amigo",
            "right": "un buen amigo",
            "why": "Перед amigo (m.sg.) нужна короткая форма buen."
          },
          {
            "wrong": "una buen idea",
            "right": "una buena idea",
            "why": "С женским родом используется buena."
          }
        ],
        "examples": [
          {
            "id": "ex1",
            "text": "Es un buen profesor.",
            "translation": "Он хороший преподаватель.",
            "notes": "",
            "tags": []
          },
          {
            "id": "ex2",
