            "translation": "Преподаватель хороший.",
            "notes": "",
            "tags": []
          },
          {
            "id": "ex3",
            "text": "una buena noticia",
            "translation": "хорошая новость",
            "notes": "",
            "tags": []
          },
          {
            "id": "ex4",
            "text": "buenos resultados",
            "translation": "хорошие результаты",
            "notes": "",
            "tags": []
          }
        ]
      }
    },
